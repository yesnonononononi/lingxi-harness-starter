<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yesnonononononi</groupId>
        <artifactId>lingXi-harness-agent</artifactId>
        <version>1.1.8-SNAPSHOT</version>
    </parent>
    <artifactId>harness-sandbox-windows</artifactId>
    <name>LingXi Harness Windows Sandbox</name>
    <dependencies>
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>harness-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.18.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.18.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <pitest.version>1.21.1</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
    </properties>

    <build>
        <plugins>
            <!-- Mutation testing: never bound to a lifecycle phase, it only runs on an explicit
                 `mvn pitest:mutationCoverage`. Only the file backend is mutated: it answers the type
                 and listing questions the tools rely on, and its enclosure checks guard the boundary. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.summit.sandbox.windows.WindowsWorkspaceFiles</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.summit.sandbox.windows.WindowsWorkspaceFilesTest</param>
                    </targetTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
