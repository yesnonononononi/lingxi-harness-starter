<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>lingxi-harness-spring-boot-starter</artifactId>
    <name>lingxi-harness-spring-boot-starter</name>
    <parent>
        <groupId>io.github.yesnonononononi</groupId>
        <artifactId>lingXi-harness-agent</artifactId>
        <version>1.1.2</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>harness-spring-boot-autoconfigure</artifactId>
        </dependency>
        <!--
            Aggregated here rather than pulled in by the auto-configuration module: the kernel tools
            depend on the runtime, so making the auto-configuration module depend on them would point
            the arrow the wrong way. The starter is what a consumer actually adds, so it is the right
            place to assemble the whole framework.
        -->
        <dependency>
            <groupId>io.github.yesnonononononi</groupId>
            <artifactId>harness-kernel-tools</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <!-- This dependency-only module has no public API for the Javadoc tool. -->
                    <execution>
                        <id>attach-javadocs</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <!-- Attach module documentation while retaining normal API docs in sibling modules. -->
                    <execution>
                        <id>attach-starter-documentation</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                            <classifier>javadoc</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
